# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Shared AI provider for every organization (judges included).
#
# Provider credentials are scoped to a user, an organization, or a workspace, so
# a key connected in Settings serves only that scope. Every signup gets its own
# organization, so a judge in a fresh organization has no provider and the
# investigation engine and chat both refuse to run.
#
# Set ONE deployment-level provider key below and every signed-in user with no
# key of their own can use it, across every organization. Usage is billed to this
# deployment's account. A user-, org-, or workspace-scoped key always takes
# precedence, so an organization that connects its own provider keeps using it.
#
# Free tiers (no credit card): Google Gemini (https://aistudio.google.com) or
# Groq (https://console.groq.com). Set exactly one; the engine is auto-detected.
# Prefer a dedicated key for this deployment, and keep it out of version control.
# GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
